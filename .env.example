# -----------------------------------------------------------------------------
# Futures System - Environment Variables Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename it to ".env"
# 2. Fill in the actual secret values below.
# 3. NEVER commit your real ".env" file to Git!
# -----------------------------------------------------------------------------

# PostgreSQL Database
DB_PASSWORD=your_database_password_here

# JWT Security
# Generate a strong, random 512-bit key for production!
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Integration (for file uploads)
CLOUDINARY_API_SECRET=your_cloudinary_secret_here

# React Frontend (if applicable)
VITE_API_URL=http://localhost:8080/api
