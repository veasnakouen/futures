@model MtpApp.ViewModels.CaseViewModel


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="card mt-3">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="fa fa-folder-open me-2"></i>
            <span>Case Management</span>
            <div class="ms-auto d-flex gap-2">
                <button data-bs-toggle="modal" data-bs-target="#caseModal" class="btn btn-success btn-sm">
                    <i class="fa fa-plus me-1"></i> Add New Case
                </button>
                <a href="@Url.Action("Index", "Clients")" class="btn btn-danger btn-sm">
                    <i class="fa fa-link me-1"></i> Manage Clients
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-12">

                    <div class="form-inline">

                        <div class="form-group">
                            <label for="displayCaseWorker">Show By Case Worker: </label>
                            <select class="form-control form-control-sm" id="displayCaseWorker">
                                <option>--Show All Cases--</option>
                                @foreach (var caseWorker in Model.CaseWorkers)
                                {
                                    <option value="@caseWorker.Id">@caseWorker.Name</option>
                                }
                            </select>
                        </div>

                        <button onclick="ShowNewCase();" class="btn btn-primary btn-sm">
                            <i class="fa fa-filter me-1"></i> New Cases
                        </button>
                        <button onclick="ShowOpenedCase();" class="btn btn-primary btn-sm">
                            <i class="fa fa-filter me-1"></i> Opened
                        </button>
                        <button onclick="ShowInProgressCase();" class="btn btn-primary btn-sm">
                            <i class="fa fa-filter me-1"></i> In Progress
                        </button>
                        <button onclick="ShowHoldCase();" class="btn btn-warning btn-sm">
                            <i class="fa fa-filter me-1"></i> Hold
                        </button>
                        <button onclick="ShowClosedCase();" class="btn btn-secondary btn-sm">
                            <i class="fa fa-filter me-1"></i> Closed
                        </button>

                    </div>

                    <hr />

                    <div class="card mt-2">
                        <div class="card-header bg-dark text-white">
                            <i class="fa fa-list me-2"></i>Case List &mdash; Status: <span id="displayCaseStatus" class="ms-1 badge bg-danger"></span>
                        </div>
                        <div class="card-body p-0">

                            <div id="overflowTable" style="overflow-x: auto;">
                                <table id="caseListTable" class="table table-hover table-bordered">
                                    <thead>
                                        <tr>
                                            <th style="width: 35px">ID</th>
                                            <th>Client</th>
                                            <th>Phone</th>
                                            <th>Program | Case Worker</th>
                                            <th>Case Priority</th>
                                            <th>Case Type</th>
                                            <th>Subject</th>
                                            <th>Open Date</th>
                                            <th>Close Date</th>
                                            <th>Status</th>
                                            <th style="width: 150px">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Clients/_CaseModal.cshtml")

@*@Html.Partial("~/Views/Clients/_FuturesTrainingModal.cshtml")*@

@section scripts
{
    @Scripts.Render("~/Scripts/Functions/casemanagement.js")
}