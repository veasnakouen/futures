                                                <th style="width: 90px;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>*@
            <div id="divLoadingModal"></div>
        </div>
    </div>

@Html.Partial("_OverDeadlineVacancyModal")

@Html.Partial("_VacancyModal")


@section scripts
{
    <script src="~/Scripts/Functions/vacancy.js"></script>
}