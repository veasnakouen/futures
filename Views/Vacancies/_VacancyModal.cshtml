@model MtpApp.ViewModels.VacancyViewModel

<div class="modal fade" id="vacancyModal" data-bs-backdrop="static" data-bs-keyboard="false" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-clipboard-list me-2"></i>Vacancy Information <span id="titleVacancy"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">

                        <input id="id" name="id" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                        <input id="employerId" name="employerId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>*Position</label>
                                <select class="form-control form-control-sm" id="jobPositionId" name="jobPositionId" style="min-width: 100%">
                                    @foreach (var jobPosition in Model.JobPositions)
                                    {
                                        <option value=@jobPosition.Id>@jobPosition.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>*Job Category</label>
                                <select class="form-control form-control-sm" id="jobCategoryId" name="jobCategoryId" style="min-width: 100%">
                                    @foreach (var jobCategory in Model.JobCategories)
                                    {
                                        <option value=@jobCategory.Id>@jobCategory.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group">
                                <label>*Position Available</label>
                                <input id="positionAvailable" name="positionAvailable" placeholder="# Position(s)" type="number" value="" class="form-control form-control-sm" style="min-width: 100%" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="contractType">*Contract Type</label>
                                <select class="form-control form-control-sm" id="contractType">
                                    <option>Full-Time</option>
                                    <option>Part-Time</option>
                                    <option>Volunteer</option>
                                    <option>Internship</option>
                                    <option>Apprenticeship</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>*Salary length from </label>
                                        <input id="salary" name="salary" placeholder="0" type="number" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label> to Salary</label>
                                        <input id="salaryMax" name="salaryMax" placeholder="0" type="number" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Schedule</label>
                                <input id="schedule" name="schedule" placeholder="Enter schedule" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Location</label>
                                <input id="location" name="location" placeholder="Enter location" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Responsibilities</label>
                                <textarea class="form-control form-control-sm" id="responsibilities" placeholder="Enter Responsibilities" rows="4" style="min-width: 100%; max-width: 100%"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Requirement</label>
                                <textarea class="form-control form-control-sm" id="requirement" placeholder="Enter requirement" rows="4" style="min-width: 100%; max-width: 100%"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Other benefic</label>
                                <textarea class="form-control form-control-sm" id="applicationInformation" placeholder="Enter application information" rows="3" style="min-width: 100%; max-width: 100%"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>*Posting Date</label>
                                <input id="postingDate" name="postingDate" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>*Deadline</label>
                                <input id="deadline" name="deadline" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="status">*Status</label>
                                <select class="form-control form-control-sm" id="status">
                                    <option>Open</option>
                                    <option>Close</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="fa fa-right-from-bracket me-1"></i>Close</button>
                    <button type="button" id="btnActivate" class="btn btn-outline-primary btn-sm js-update" onclick="Activate();"><i class="fa fa-circle-check me-1"></i>Activate</button>
                    <button type="button" id="btnUpdate" class="btn btn-primary btn-sm js-update" onclick="Update();"><i class="fa fa-floppy-disk me-1"></i>Update</button>
                    <button type="button" id="btnSave" class="btn btn-success btn-sm" onclick="Save();"><i class="fa fa-floppy-disk me-1"></i>Save</button>
                </div>
                <div id="divLoadingModal"></div>
            </div>
        </div>
    </div>
</div>
