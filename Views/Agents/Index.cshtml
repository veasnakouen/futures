   
@{
    ViewBag.Title = "Index";
}

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h5 class="panel-title pull-left" style="padding-top: 9px;">Manage Agents</h5>
        <button onclick="clearForm();" type="button" data-toggle="modal" data-target="#agentModal" class="btn btn-primary pull-right"><i class="glyphicon glyphicon-plus-sign"></i> Add Agent</button>
    </div>
    <div class="panel-body">
        <table id="agents" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Agent name</th>
                    <th style="width: 150px;">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<form id="formAgent" method="post" enctype="multipart/form-data">
    <div class="modal fade" data-backdrop="static" data-keyboard="false" id="agentModal" tabindex="-1" role="dialog" aria-labelledby="agentModal" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body">

                    <input id="id" name="id" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                    <div class="form-group">
                        <label>Agent name</label>
                        <input id="name" name="name" placeholder="Enter agent name" type="text" value="" class="form-control" style="min-width: 100%" />
                    </div>

                    <div class="form-group">
                        <label>Upload Photo</label>
                        <input onchange="readURL(this);" type="file" name="file" id="file" style="width: 100%;" />
                    </div>

                    <div class="form-group">
                        <img class="center img-responsive" id="photo" src="" />
                    </div>

                    <div class="clearfix">
                        <button type="button" class="btn btn-danger pull-right" data-dismiss="modal">Close</button>
                        <button type="button" id="btnSave" class="btn btn-primary pull-right" onclick="Save();">Save</button>
                        <button type="button" id="btnUpdate" class="btn btn-primary pull-right js-update" onclick="Update();">Update</button>
                    </div>

                    <div id="loaderDiv" style="text-align:center; display:none;">
                        <img src="~/Content/InternetSlowdown_Day.gif" width="100" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>



@section scripts
{
    <script>
        $(document).ready(function () {
            GetAgents();

            $('#agentModal').on('shown.bs.modal', function () {
                $('#name').focus();
            });
        });

        var table = [];

        function GetAgents() {
            table = $('#agents').DataTable({
                ajax: {
                    url: "/api/agents",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return "<a href='#' onclick='Edit(" + data + ")'><span class='glyphicon glyphicon-edit'></span> Edit</a>" + " | " + "<a href='#' onclick='Delete(" + data + ")'><span class='glyphicon glyphicon-trash'></span> Delete</a>"
                        }
                    }
                ]
            });
        }

        //Delete
        function Delete(id) {
            bootbox.confirm("Are you sure you want to delete this agent?", function (result) {
                if (result) {
                    $.ajax({
                        url: "/api/agents/" + id,
                        method: "DELETE",
                        success: function () {
                            table.ajax.reload();
                            toastr.success("Agent has been deleted successfully.");
                        },
                        error: function () {
                            toastr.error("Cannot delete this item.");
                        }
                    })
                }
            });
        }

        //Update
        function Update() {
            var res = validate();
            if (res === false) {
                return false;
            }

            $("#loaderDiv").show();

            var data = new FormData();
            var files = $("#file").get(0).files;

            if (files.length > 0) {
                data.append("UploadedFile", files[0]);
            }

            data.append("id", $("#id").val());
            data.append("name", $("#name").val());

            var ajaxRequest = $.ajax({
                type: "PUT",
                url: "/api/agents/" + $("#id").val(),
                contentType: false,
                processData: false,
                data: data,
                success: function (result) {
                    toastr.success("Agent has been updated.");
                    clearForm();
                    table.ajax.reload();
                    $("#loaderDiv").hide();
                    $('#agentModal').modal('hide');
                },
                error: function (errormessage) {
                    toastr.error("Something unexpected happen.");
                }
            });
        }

        //Edit
        function Edit(id) {
            clearForm();

            $.ajax({
                url: "/api/agents/" + id,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                success: function (result) {
                    $('#id').val(result.id);
                    $('#name').val(result.name);
                    $('#photo').attr('src', '/Images/' + result.photo)

                    $('#agentModal').modal('show');
                    $('#btnUpdate').show();
                    $('#btnSave').hide();
                },
                error: function (errormessage) {
                    toastr.error("Something unexpected happen.");
                }
            });
            return false;
        }

        //Save
        function Save() {
            var res = validate();
            if (res == false) {
                return false;
            }

            $("#loaderDiv").show();

            var data = new FormData();
            var files = $("#file").get(0).files;

            if (files.length > 0) {
                data.append("UploadedFile", files[0]);
            }

            data.append("name", $("#name").val());

            var ajaxRequest = $.ajax({
                type: "POST",
                url: "/api/agents",
                contentType: false,
                processData: false,
                data: data,
                success: function (result) {
                    toastr.success("Agent has been added to database.");
                    clearForm();
                    table.ajax.reload();
                    $("#loaderDiv").hide();
                    $('#agentModal').modal('hide');
                },
                error: function (errormessage) {
                    toastr.error("Something unexpected happen.");
                }
            });
        }

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#photo').attr('src', e.target.result);
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearForm() {
            $('#id').val('');
            $('#name').val('');
            $('#file').val('');
            $('#photo').attr('src', '');
            $('#btnUpdate').hide();
            $('#btnSave').show();
            $('#id').css('border-color', '#cccccc');
            $('#name').css('border-color', '#cccccc');
        }

        function validate() {
            var isValid = true;
            if ($('#name').val().trim() == "") {
                $('#name').css('border-color', 'red');
                $('#name').focus();
                isValid = false;
            } else {
                $('#name').css('border-color', '#cccccc');
            }
            return isValid;
        }
    </script>
}