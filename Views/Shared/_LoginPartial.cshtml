@if (User?.Identity?.IsAuthenticated == true)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-flex align-items-center" }))
    {
    @Html.AntiForgeryToken()

    <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle px-2" data-bs-toggle="dropdown" role="button">
                <i class="fa fa-bell me-1"></i><b class="NumberNotification badge bg-danger rounded-pill" style="font-size:.7rem;"></b>
            </a>
            <ul class="dropdown-menu dropdown-menu-end notify-drop" style="min-width:300px;">
                <div class="notify-drop-title px-3 py-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <input id="countskipNumber" name="countskipNumber" type="number" style="display: none;" disabled="disabled" value="0" class="form-control" />
                        <span class="fw-semibold">Notifications (<b class="NumberNotification"></b>)</span>
                        <a href="" class="text-muted small"><i class="fa fa-check-double"></i> Mark all read</a>
                    </div>
                </div>
                <div class="drop-content" style="max-height:300px;overflow-y:auto;"></div>
                <div class="notify-drop-footer text-center py-2 border-top">
                    <a href="" class="text-decoration-none small"><i class="fa fa-eye me-1"></i>View all monitoring</a>
                </div>
            </ul>
        </li>
        <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle px-2" data-bs-toggle="dropdown">
                <i class="fa fa-user-circle me-1"></i>@(User.Identity?.Name ?? "")
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage"><i class="fa fa-key me-2 text-muted"></i>Change Password</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item text-danger" href="javascript:document.getElementById('logoutForm').submit()"><i class="fa fa-sign-out-alt me-2"></i>Log off</a></li>
            </ul>
        </li>
    </ul>
    }
}
