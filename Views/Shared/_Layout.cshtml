                                <option value="1">1st : 1 month</option>
                                <option value="2">2nd : 2 months</option>
                                <option value="3">3rd : 3 months</option>
                                <option value="4">4th : 4 months</option>
                                <option value="5">5th : 5 months</option>
                                <option value="6">6th : 6 months</option>
                                <option value="8">8th : 8 months</option>
                                <option value="10">10th : 10 months</option>
                                <option value="12">Final</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="placementcompleted">Completed</label>
                            <select class="form-control form-control-sm" id="placementcompleted" name="placementcompleted" style="min-width: 100%">
                                <option value="">Please select this</option>
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="placementsalary">Salary</label>
                            <input id="placementsalary" name="placementsalary" placeholder="Enter salary" class="form-control input-sm " style="min-width: 100%">
                        </div>
                    </div>

                    <!--Placementcontrol-->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="Placementcontrol">
                                <input id="placementprocessMonitoringId" name="placementprocessMonitoringId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                                <hr />
                                <label for="placementMonitoringstatus">Still in Placement</label>
                                <div class="row">
                                    <!-- Still in business  -->
                                    <div class="col-md-12">
                                        <label class="radio-inline col-md-2">
                                            <input type="radio" name="placementMonitoringstatus" id="stillinPlacementMonitoringYes" value="Yes" checked>Yes
                                        </label>
                                        <label class="radio-inline col-md-2">
                                            <input type="radio" name="placementMonitoringstatus" id="stillinPlacementMonitoringNo" value="No">No
                                        </label>
                                        <label class="radio-inline col-md-4">
                                            <input type="radio" name="placementMonitoringstatus" id="stillinPlacementChangeJobMonitoring" value="ChangedJob">Changed Job
                                        </label>
                                    </div>
                                </div><div class="row">
                                    <input id="placementpmonitoringsId" name="placementpmonitoringsId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <label for="placementprogressnotes">Placement progress note</label>
                                        <input id="placementprogressnotes" name="placementprogressnotes" placeholder="Enter placement progress note" class="form-control input-sm " style="min-width: 100%">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <div id="overflowTable" style="overflow-x: auto;">
                                <table id="PlacementMonitoringActionTable" class="table table-hover table-bordered" style="width: 100%">
                                    <thead>
                                        <tr>
                                            <th>Monitor date</th>
                                            <th>Complete</th>
                                            <th>Placement</th>
                                            <th>Place Status</th>
                                            <th>Salary</th>
                                            <th>Note</th>
                                            <th style="width: 90px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="modal-footer" style="overflow:auto;">
                    <div style="float:right;">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="button" onclick="PlacementMonitoringActionNotification();" id="btnPlacementProcessMonitoringAction" class="btn btn-primary btn-sm">Add New</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container-fluid d-flex justify-content-between">
            <span><i class="fa fa-heart text-danger"></i> &copy; @DateTime.Now.Year M'Lop Tapang Organization</span>
            <span class="opacity-75">Future Management System</span>
        </div>
    </footer>

    <div id="divLoading"></div>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        (function ($) {
            // ── flatpickr shim: make all $(...).datepicker({}) calls use flatpickr ──
            // Individual view pages call  $(".js-date").datepicker({...})
            // This shim transparently redirects those calls to flatpickr so no
            // view file needs to change.
            $.fn.datepicker = function () {
                return this.each(function () {
                    if (this._flatpickr) return; // already initialised
                    flatpickr(this, {
                        dateFormat: 'm/d/Y',
                        allowInput: true,
                        disableMobile: false,
                        appendTo: $(this).closest('.modal')[0] || document.body,
                        monthSelectorType: 'dropdown',
                        yearRange: [1950, 2100]
                    });
                });
            };

            // Auto-init every .js-date present now or added later (e.g. inside modals).
            $(document).on('shown.bs.modal focus', '.js-date', function () {
                if (!this._flatpickr) { $(this).datepicker(); }
            });
            $(function () { $('.js-date').datepicker(); });

            // ── Modal stacking (z-index) ────────────────────────────────────────────
            $(document).on('shown.bs.modal', '.modal', function () {
                var zIndex = 1050 + ($('.modal.show').length * 20);
                $(this).css('z-index', zIndex);
                window.setTimeout(function () {
                    $('.modal-backdrop').not('.modal-stack').last().css('z-index', zIndex - 1).addClass('modal-stack');
                }, 0);
            });

            $(document).on('hidden.bs.modal', '.modal', function () {
                if ($('.modal.show').length > 0) {
                    $('body').addClass('modal-open');
                }
            });
        })(window.jQuery);
    </script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script>
        // ── Global DataTables defaults ───────────────────────────────────────────
        // dom: f = filter (top-right), r = processing, t = table,
        //      <"dt-bottom-row"li> = bottom bar: info (left) + length + pagination (right)
        $.extend(true, $.fn.dataTable.defaults, {
            dom: '<"dt-top-row"f>rt<"dt-bottom-row"lip>'
        });
    </script>
    <script src="~/Scripts/moment.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/bootbox.min.js"></script>
    <script>
        // ── Global bootbox.confirm override ──────────────────────────────────────
        // All JS files call bootbox.confirm(message, callback) with a plain string.
        // We intercept that form here and replace it with a fully styled dialog
        // so no individual JS file needs to change.
        (function () {
            if (!window.bootbox) { return; }

            var _orig = bootbox.confirm.bind(bootbox);

            bootbox.confirm = function (options, callback) {
                // Only restyle the simple (string, callback) signature
                if (typeof options !== 'string') {
                    return _orig(options, callback);
                }

                var message = options;
                var isDelete = /delete|remove/i.test(message);

                var icon    = isDelete
                    ? '<i class="fa fa-triangle-exclamation fa-lg me-2 text-danger"></i>'
                    : '<i class="fa fa-circle-question fa-lg me-2 text-warning"></i>';
                var title   = isDelete ? 'Confirm Delete' : 'Confirm Action';
                var btnClass = isDelete ? 'btn-danger' : 'btn-warning';
                var btnLabel = isDelete ? '<i class="fa fa-trash me-1"></i> Delete' : '<i class="fa fa-check me-1"></i> Confirm';

                return bootbox.dialog({
                    title: icon + title,
                    message: '<p class="mb-0">' + message + '</p>',
                    size: 'small',
                    onEscape: true,
                    backdrop: true,
                    buttons: {
                        cancel: {
                            label: '<i class="fa fa-xmark me-1"></i> Cancel',
                            className: 'btn-secondary'
                        },
                        confirm: {
                            label: btnLabel,
                            className: btnClass,
                            callback: callback
                        }
                    }
                });
            };
        })();
    </script>
    <script>
        (function ($, bootstrap) {
            if (!$ || !bootstrap || !bootstrap.Modal) {
                return;
            }

            var oldModal = $.fn.modal;

            $.fn.modal = function (option, relatedTarget) {
                return this.each(function () {
                    var options = typeof option === 'object' && option !== null ? option : {};
                    var nestedModalIsOpen = document.querySelector('.modal.show') && !this.classList.contains('show');

                    if (nestedModalIsOpen) {
                        options = $.extend({ focus: false, keyboard: false }, options);
                    }

                    var instance = bootstrap.Modal.getOrCreateInstance(this, options);

                    if (nestedModalIsOpen && instance && instance._config) {
                        instance._config.focus = false;
                        instance._config.keyboard = false;
                    }

                    if (typeof option === 'string') {
                        if (typeof instance[option] !== 'function') {
                            throw new TypeError('No method named "' + option + '"');
                        }

                        instance[option](relatedTarget);
                        return;
                    }

                    if (option === undefined || options.show !== false) {
                        instance.show(relatedTarget);
                    }
                });
            };

            $.fn.modal.Constructor = bootstrap.Modal;
            $.fn.modal.noConflict = function () {
                $.fn.modal = oldModal;
                return this;
            };
        })(window.jQuery, window.bootstrap);
    </script>
    <script>
        (function () {
            if (!window.bootstrap || !window.bootstrap.Modal) { return; }

            // ─────────────────────────────────────────────────────────────────────
            // Nested-modal support for Bootstrap 5
            //
            // THREE problems when a child modal opens inside a parent modal:
            //
            //  A) Bootstrap's data-api click handler calls
            //     Modal.getInstance(openParent).hide() before showing the child,
            //     which closes the parent.
            //
            //  B) Bootstrap activates a FocusTrap on every shown modal.
            //     When two are open, the parent's trap immediately steals focus
            //     back from any element clicked inside the child — inputs become
            //     unresponsive.
            //
            //  C) The child modal's OWN newly-activated focustrap also fights
            //     with the parent's trap.
            //
            // Fixes:
            //  A) Patch Modal.prototype.hide
            //  B) Patch Modal.prototype.show  ← most reliable approach
            //  C) show/shown/hidden.bs.modal event listeners as safety nets
            // ─────────────────────────────────────────────────────────────────────

            /* ── A: Protect parent from being hidden ──────────────────────────── */
            var _protectedModal = null;

            document.addEventListener('mousedown', function (e) {
                var trigger = e.target.closest('[data-bs-toggle="modal"]');
                _protectedModal = trigger ? trigger.closest('.modal') : null;
            }, true);

            document.addEventListener('click', function () {
                setTimeout(function () { _protectedModal = null; }, 200);
            }, true);

            var _origHide = window.bootstrap.Modal.prototype.hide;
            window.bootstrap.Modal.prototype.hide = function () {
                if (_protectedModal && _protectedModal === this._element) { return; }
                _origHide.call(this);
            };

            /* ── B: Patch show() — runs INSIDE Bootstrap before _showElement()
                    so focus:false is set before focustrap.activate() is called.
                    This is the most reliable path because the instance is fully
                    constructed at this point regardless of how show() was called. */
            var _origShow = window.bootstrap.Modal.prototype.show;
            window.bootstrap.Modal.prototype.show = function (relatedTarget) {
                var isNested = document.querySelector('.modal.show') &&
                               this._element !== document.querySelector('.modal.show');
                if (isNested) {
                    // Disable this modal's own focustrap before _showElement runs
                    if (this._config) { this._config.focus = false; }
                    // Also silence the already-open parent modal's trap
                    document.querySelectorAll('.modal.show').forEach(function (el) {
                        var inst = window.bootstrap.Modal.getInstance(el);
                        if (!inst) { return; }
                        if (inst._config) { inst._config.focus = false; }
                        if (inst._focustrap) { try { inst._focustrap.deactivate(); } catch (_) {} }
                    });
                }
                _origShow.call(this, relatedTarget);
            };

            /* ── Helper: silence all focustraps on every open modal ───────────── */
            function deactivateAllTraps() {
                document.querySelectorAll('.modal.show').forEach(function (el) {
                    var inst = window.bootstrap.Modal.getInstance(el);
                    if (!inst) { return; }
                    if (inst._config) { inst._config.focus = false; }
                    if (inst._focustrap) { try { inst._focustrap.deactivate(); } catch (_) {} }
                });
            }

            /* ── Safety net: shown.bs.modal fires after animation completes.
                    By this time the instance definitely exists and any focustrap
                    that slipped through the show() patch is cleaned up. ────────── */
            document.addEventListener('shown.bs.modal', function () {
                var openModals = document.querySelectorAll('.modal.show');
                if (openModals.length <= 1) { return; }
                deactivateAllTraps();
            }, true);

            /* ── Restore focustrap for the remaining top modal after child closes. */
            document.addEventListener('hidden.bs.modal', function () {
                setTimeout(function () {
                    var openModals = document.querySelectorAll('.modal.show');
                    if (openModals.length === 0) { return; }
                    var topEl = openModals[openModals.length - 1];
                    var inst = window.bootstrap.Modal.getInstance(topEl);
                    if (inst) {
                        if (inst._config) { inst._config.focus = true; }
                        if (inst._focustrap) { try { inst._focustrap.activate(); } catch (_) {} }
                    }
                }, 50);
            }, true);

        })();
    </script>
    <script>
        // Make every modal dialog scrollable (vertical) and protect against
        // wide content (e.g. DataTables) pushing the modal beyond the viewport.
        document.addEventListener('DOMContentLoaded', function () {

            // 1. Scrollable dialogs — header/footer pinned, body scrolls vertically.
            document.querySelectorAll('.modal-dialog').forEach(function (d) {
                d.classList.add('modal-dialog-scrollable');
            });

            // 2. Wrap every bare <table> inside a modal-body with .table-responsive
            //    BEFORE DataTables initialises so horizontal overflow scrolls inside
            //    the wrapper instead of pushing the whole modal wider.
            document.querySelectorAll('.modal-body table').forEach(function (t) {
                if (!t.closest('.table-responsive')) {
                    var wrapper = document.createElement('div');
                    wrapper.className = 'table-responsive';
                    t.parentNode.insertBefore(wrapper, t);
                    wrapper.appendChild(t);
                }
            });
        });
    </script>
    @RenderSection("scripts", required: false)
    <script src="~/js/site.js"></script>
    <script>
        // ── Global DataTable action-cell beautifier ─────────────────────────────
        // Runs on every DataTable draw (all pages, all tables).
        // Handles three different patterns found across the JS files:
        //   1. <a onclick='…'> | <a onclick='…'>           (most files)
        //   2. <a class='btn btn-*'> …                      (futuresdashboard.js)
        //   3. <button class='btn btn-warning/danger'> …    (client.js)
        $(document).on('draw.dt', function (e) {
            $(e.target).find('tbody tr td').each(function () {
                var $td = $(this);
                if ($td.hasClass('dt-actions-done')) { return; }

                // Only process cells whose element children are <a> and/or <button> tags
                var $elems = $td.children();
                if ($elems.length === 0) { return; }
                if ($elems.not('a, button').length > 0) { return; }

                $td.addClass('dt-actions-done');

                $elems.each(function () {
                    var $el = $(this);

                    // ── If element already carries Bootstrap btn classes,
                    //    strip them so our outline style takes over cleanly.
                    if ($el.hasClass('btn')) {
                        $el.removeClass(function (_, cls) {
                            return (cls.match(/\bbtn(-\S+)?/g) || []).join(' ');
                        });
                    }

                    $el.addClass('dt-action-link');

                    var txt       = $el.text().trim().toLowerCase();
                    var iconClass = ($el.find('i').attr('class') || '');

                    if (iconClass.indexOf('fa-trash') !== -1 || txt === 'delete' || txt === 'del') {
                        $el.addClass('dt-action-delete');
                    } else if (iconClass.indexOf('fa-pen') !== -1 || txt === 'edit') {
                        $el.addClass('dt-action-edit');
                    } else if (iconClass.indexOf('fa-share') !== -1 || iconClass.indexOf('fa-rotate') !== -1 || iconClass.indexOf('fa-repeat') !== -1 || txt === 'open' || txt === 'in progress' || txt === 'reopen') {
                        $el.addClass('dt-action-open');
                    } else if (iconClass.indexOf('fa-circle-check') !== -1 || txt === 'close') {
                        $el.addClass('dt-action-close');
                    } else if (iconClass.indexOf('fa-stop') !== -1 || txt === 'hold') {
                        $el.addClass('dt-action-hold');
                    } else if (iconClass.indexOf('fa-eye') !== -1 || txt === 'detail' || txt === 'view') {
                        $el.addClass('dt-action-view');
                    } else {
                        $el.addClass('dt-action-other');
                    }
                });

                // Wrap in flex container — also removes bare " | " text nodes
                $td.wrapInner('<div class="dt-actions"></div>');
            });
        });
    </script>
    <script src="~/Scripts/jquery.signalR-2.4.1.min.js"></script>
    <script src="~/js/placement-monitoring.js"></script>

    <script>
