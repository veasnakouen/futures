    </script>

    <script>
        // ── Bootstrap 5 nested modal fix ────────────────────────────────────────
        // When a child modal opens on top of a parent modal, Bootstrap adds a
        // second backdrop at z-index 1040 which overlays the child modal dialog
        // (z-index 1055), making all buttons inside the child unclickable.
        // Fix: stack each new modal and its backdrop above the previous one.
        $(document).on('show.bs.modal', '.modal', function () {
            var $visibleModals = $('.modal.show');
            if ($visibleModals.length > 0) {
                var zIndex = 1055 + ($visibleModals.length * 20);
                $(this).css('z-index', zIndex);
                setTimeout(function () {
                    // Move the most-recently-added backdrop above previous modals
                    $('.modal-backdrop').not('.modal-stack').css('z-index', zIndex - 1).addClass('modal-stack');
                }, 0);
            }
        });

        // Re-enable body scroll class when a nested modal closes but a parent is still open
        $(document).on('hidden.bs.modal', '.modal', function () {
            if ($('.modal.show').length > 0) {
                $('body').addClass('modal-open');
            }
        });
    </script>

</body>
