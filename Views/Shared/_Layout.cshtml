<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>M'Lop Tapang — @(ViewBag.Title ?? "Future Management System")</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/DataTables/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/Content/toastr.min.css" />
    <link rel="stylesheet" href="~/Content/Site.css" />
    <link rel="stylesheet" href="~/Content/DropDownNotification.css" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    @RenderSection("head", required: false)
</head>
<body id="FutureSystemId" class="@(string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase) ? "home-page" : string.Empty)">

    @Html.Partial("_Navbar")

    <div class="body-content container-fluid @(string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase) ? "home-shell" : "px-3 px-lg-4 pt-3")">
        @RenderBody()
    </div>

    <div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="placementMonitoringActionModal" tabindex="-1" role="dialog" aria-labelledby="placementMonitoringActionModal" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-building me-2"></i>Add Placement Monitoring <span id="PlacementMonitoringCompany"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!--Monitoring-->
                        <input id="PlacementMonitoringId" name="PlacementMonitoringId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                        <input id="placementclientId" name="placementclientId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                        <input id="PlacementMonitoringCounttimeId" name="PlacementMonitoringCounttimeId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                        <input id="placementMonitoringenrollby" name="placementMonitoringenrollby" type="text" style="display: none;" disabled="disabled" value="Admin Manager" class="form-control" />
                    </div>

                    <div class="row">

                        <div class="col-md-3">
                            <label for="placementnextmonitoringdate">Next placement monitoring Date</label>
                            <input id="placementnextmonitoringdate" name="placementnextmonitoringdate" placeholder="Enter next monitoring date" class="form-control input-sm js-date " style="min-width: 100%">
                        </div>

                        <div class="col-md-3">
                            <label for="placementmonitoringtype">Monitoring type</label>
                            <select class="form-control form-control-sm" id="placementmonitoringtype" name="placementmonitoringtype" style="min-width: 100%">
                                <option value="">Select monitor type</option>
                                <option value="1">1st : 1 month</option>
                                <option value="2">2nd : 2 months</option>
                                <option value="3">3rd : 3 months</option>
                                <option value="4">4th : 4 months</option>
                                <option value="5">5th : 5 months</option>
                                <option value="6">6th : 6 months</option>
                                <option value="8">8th : 8 months</option>
                                <option value="10">10th : 10 months</option>
                                <option value="12">Final</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="placementcompleted">Completed</label>
                            <select class="form-control form-control-sm" id="placementcompleted" name="placementcompleted" style="min-width: 100%">
                                <option value="">Please select this</option>
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="placementsalary">Salary</label>
                            <input id="placementsalary" name="placementsalary" placeholder="Enter salary" class="form-control input-sm " style="min-width: 100%">
                        </div>
                    </div>

                    <!--Placementcontrol-->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="Placementcontrol">
                                <input id="placementprocessMonitoringId" name="placementprocessMonitoringId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                                <hr />
                                <label for="placementMonitoringstatus">Still in Placement</label>
                                <div class="row">
                                    <!-- Still in business  -->
                                    <div class="col-md-12">
                                        <label class="radio-inline col-md-2">
                                            <input type="radio" name="placementMonitoringstatus" id="stillinPlacementMonitoringYes" value="Yes" checked>Yes
                                        </label>
                                        <label class="radio-inline col-md-2">
                                            <input type="radio" name="placementMonitoringstatus" id="stillinPlacementMonitoringNo" value="No">No
                                        </label>
                                        <label class="radio-inline col-md-4">
                                            <input type="radio" name="placementMonitoringstatus" id="stillinPlacementChangeJobMonitoring" value="ChangedJob">Changed Job
                                        </label>
                                    </div>
                                </div><div class="row">
                                    <input id="placementpmonitoringsId" name="placementpmonitoringsId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <label for="placementprogressnotes">Placement progress note</label>
                                        <input id="placementprogressnotes" name="placementprogressnotes" placeholder="Enter placement progress note" class="form-control input-sm " style="min-width: 100%">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <div id="overflowTable" style="overflow-x: auto;">
                                <table id="PlacementMonitoringActionTable" class="table table-hover table-bordered" style="width: 100%">
                                    <thead>
                                        <tr>
                                            <th>Monitor date</th>
                                            <th>Complete</th>
                                            <th>Placement</th>
                                            <th>Place Status</th>
                                            <th>Salary</th>
                                            <th>Note</th>
                                            <th style="width: 90px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="modal-footer" style="overflow:auto;">
                    <div style="float:right;">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="button" onclick="PlacementMonitoringActionNotification();" id="btnPlacementProcessMonitoringAction" class="btn btn-primary btn-sm">Add New</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container-fluid d-flex justify-content-between">
            <span><i class="fa fa-heart text-danger"></i> &copy; @DateTime.Now.Year M'Lop Tapang Organization</span>
            <span class="opacity-75">Future Management System</span>
        </div>
    </footer>

    <div id="divLoading"></div>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script>
        (function ($) {
            if (!$ || !$.datepicker) {
                return;
            }

            $.datepicker.setDefaults({
                showAnim: 'fadeIn',
                beforeShow: function (input, inst) {
                    var modal = $(input).closest('.modal');
                    window.setTimeout(function () {
                        $(inst.dpDiv).css({
                            zIndex: 2000
                        });

                        if (modal.length > 0) {
                            $(inst.dpDiv).appendTo(modal);
                        }
                    }, 0);
                }
            });

            $(document).on('shown.bs.modal', '.modal', function () {
                var zIndex = 1050 + ($('.modal.show').length * 20);
                $(this).css('z-index', zIndex);

                window.setTimeout(function () {
                    $('.modal-backdrop').not('.modal-stack').last().css('z-index', zIndex - 1).addClass('modal-stack');
                }, 0);
            });

            $(document).on('hidden.bs.modal', '.modal', function () {
                if ($('.modal.show').length > 0) {
                    $('body').addClass('modal-open');
                }
            });
        })(window.jQuery);
    </script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/bootbox.min.js"></script>
    <script>
        (function ($, bootstrap) {
            if (!$ || !bootstrap || !bootstrap.Modal) {
                return;
            }

            var oldModal = $.fn.modal;

            $.fn.modal = function (option, relatedTarget) {
                return this.each(function () {
                    var options = typeof option === 'object' && option !== null ? option : {};
                    var nestedModalIsOpen = document.querySelector('.modal.show') && !this.classList.contains('show');

                    if (nestedModalIsOpen) {
                        options = $.extend({ focus: false, keyboard: false }, options);
                    }

                    var instance = bootstrap.Modal.getOrCreateInstance(this, options);

                    if (nestedModalIsOpen && instance && instance._config) {
                        instance._config.focus = false;
                        instance._config.keyboard = false;
                    }

                    if (typeof option === 'string') {
                        if (typeof instance[option] !== 'function') {
                            throw new TypeError('No method named "' + option + '"');
                        }

                        instance[option](relatedTarget);
                        return;
                    }

                    if (option === undefined || options.show !== false) {
                        instance.show(relatedTarget);
                    }
                });
            };

            $.fn.modal.Constructor = bootstrap.Modal;
            $.fn.modal.noConflict = function () {
                $.fn.modal = oldModal;
                return this;
            };
        })(window.jQuery, window.bootstrap);
    </script>
    <script>
        (function () {
            var nestedModalCount = 0;

            document.addEventListener('click', function (event) {
                var trigger = event.target.closest('.modal [data-bs-toggle="modal"]');

                if (!trigger) {
                    return;
                }

                var targetSelector = trigger.getAttribute('data-bs-target');
                if (!targetSelector) {
                    return;
                }

                var targetModal = document.querySelector(targetSelector);
                var parentModal = trigger.closest('.modal');

                if (!targetModal || !parentModal) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                nestedModalCount += 1;
                targetModal.setAttribute('data-parent-modal', parentModal.id || '');

                window.bootstrap.Modal.getOrCreateInstance(targetModal, { focus: false, keyboard: false }).show(trigger);
            }, true);

            document.addEventListener('hide.bs.modal', function (event) {
                if (event.target && event.target.classList && event.target.classList.contains('modal') && event.target.id === 'clientModal' && nestedModalCount > 0) {
                    event.preventDefault();
                }
            }, true);

            document.addEventListener('hidden.bs.modal', function (event) {
                if (event.target && event.target.classList && event.target.classList.contains('modal') && event.target.hasAttribute('data-parent-modal')) {
                    nestedModalCount = Math.max(0, nestedModalCount - 1);
                    event.target.removeAttribute('data-parent-modal');
                }
            }, true);
        })();
    </script>
    @RenderSection("scripts", required: false)
    <script src="~/js/site.js"></script>
    <script src="~/Scripts/jquery.signalR-2.4.1.min.js"></script>
    <script src="~/js/placement-monitoring.js"></script>

    <script>
        // SignalR connection for placement monitoring
        $(function () {
            var hubNotify = $.connection.placementMonitorHub;
            $.connection.hub.start().done(function () {
                getAll(0);
            });
            hubNotify.client.refreshEmployeeData = function () {
                getAll(0);
            };
        });
    </script>

</body>
</html>


