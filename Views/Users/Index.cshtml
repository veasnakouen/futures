@model IEnumerable<MtpApp.Models.ApplicationUser>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="fa fa-user-cog me-2"></i>
            <span class="fw-semibold">Manage Users</span>
            @Html.ActionLink("Add User", "Register", "Account", null, new { @class = "btn btn-success btn-sm ms-auto" })
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Fullname</th>
                        <th>Email</th>
                        <th>Branch</th>
                        <th>Phone Number</th>
                        <th style="width: 220px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>@user.Branch</td>
                            <td>@user.PhoneNumber</td>
                            <td>
                                @Html.ActionLink("Permission", "GetUser/" + user.Id, "Users") |
                                @Html.ActionLink("Edit", "EditUser/" + user.Id, "Account") |
                                @Html.ActionLink("Delete", "DeleteUser/" + user.Id, "Account", null, new { onclick = "return confirm('Are you sure you wish to delete this user?');" })
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
