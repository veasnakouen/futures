@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="stat-card stat-bg-blue">
            <div class="stat-icon"><i class="fa fa-users"></i></div>
            <div>
                <div class="stat-value" id="TotalClientDashboard">—</div>
                <div class="stat-label">Total Clients</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-bg-green">
            <div class="stat-icon"><i class="fa fa-briefcase"></i></div>
            <div>
                <div class="stat-value" id="TotalEmployerDashboard">—</div>
                <div class="stat-label">Total Employers</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-bg-orange">
            <div class="stat-icon"><i class="fa fa-book"></i></div>
            <div>
                <div class="stat-value" id="TotalLogbookDashboard">—</div>
                <div class="stat-label">Total Logbooks</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-bg-purple">
            <div class="stat-icon"><i class="fa fa-clipboard-check"></i></div>
            <div>
                <div class="stat-value" id="TotalPlacementDashboard">—</div>
                <div class="stat-label">Total Placements</div>
            </div>
        </div>
    </div>
</div>


<div class="row g-3 mb-5">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header bg-dark text-white d-flex align-items-center gap-3">
                <i class="fa fa-chart-pie"></i>
                <span>Data Chart</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="badge bg-secondary" id="drawChartSelectBoxTotal" style="font-size:.85rem;padding:.4rem .7rem;"></span>
                    <select class="form-select form-select-sm" id="drawChartSelectBox" style="width:auto;">
                        <option value="TotalClient">Total Clients</option>
                        <option value="TotalEmployers">Total Employers</option>
                        <option value="TotalLogbooks">Total Logbooks</option>
                        <option value="TotalPlacements">Total Placements</option>
                    </select>
                </div>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-2">
                <div id="piechart" style="width:100%;min-height:340px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-dark text-white">
                <i class="fa fa-history me-2"></i>Recent Access
            </div>
            <div class="card-body p-2">
                <table id="loggedRecordsTable" class="table table-sm mb-0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Logged by</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    div.google-visualization-tooltip {
        white-space: nowrap;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #435279;
        padding: 10px;
        color: #3d4f61;
    }
</style>

@section scripts
{
    <script>
        $(document).ready(function () {
            GetLoggedRecords();
            GetTotalData();
        });

        var tableLoggedRecords = [];

        function GetLoggedRecords() {
            tableLoggedRecords = $('#loggedRecordsTable').DataTable({
                ajax: { url: "/api/Login/loggedrecords", dataSrc: "" },
                columns: [
                    { data: "loggedBy" },
                    { data: function (d) { return moment(d.loggedDate).format("DD MMM YYYY HH:mm"); } }
                ],
                destroy: true,
                order: [[0, "desc"]],
                info: false,
                searching: false,
                paging: false
            });
        }

        function GetTotalData() {
            $.ajax({
                url: "/api/Login/Totaldata",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    var map = {};
                    $.each(result, function (_, item) { map[item.label] = item.value; });
                    $("#TotalClientDashboard").text(map["Clients"] ?? 0);
                    $("#TotalEmployerDashboard").text(map["Employers"] ?? 0);
                    $("#TotalLogbookDashboard").text(map["LogBooks"] ?? 0);
                    $("#TotalPlacementDashboard").text(map["Placements"] ?? 0);
                }
            });
        }
    </script>

    <script src="~/Scripts/charts-loader.js"></script>
    <script type="text/javascript">
        $('#drawChartSelectBox').on('change', function () {
            drawChart($(this).val(), 0, 0, 0);
        });

        google.charts.load('current', { packages: ['corechart'] });
        google.charts.setOnLoadCallback(function () { drawChart('TotalClient', 0, 0, 0); });

        function drawChart(ItemByCategory) {
            $.ajax({
                url: "/api/clients?Client=" + ItemByCategory,
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    var w = $('#piechart').width();
                    var h = Math.max(280, Math.min(w * .55, 420));

                    const Dat = Object.values(result['table']).map(Object.values);
                    var dataArray = Dat;
                    var total = getTotal(dataArray);

                    $('#drawChartSelectBoxTotal').text(
                        $("#drawChartSelectBox option:selected").text() + ': ' + total
                    );

                    for (var i = 0; i < dataArray.length; i++) {
                        dataArray[i].push(customTooltip(dataArray[i][0], dataArray[i][1], total));
                    }
                    for (var i = 0; i < dataArray.length; i++) {
                        dataArray[i][0] = dataArray[i][0] + ' ' + dataArray[i][1] +
                            ' (' + ((dataArray[i][1] / total) * 100).toFixed(1) + '%)';
                    }
                    dataArray.unshift(['Goal Name', 'No. of times Requested', 'Tooltip']);

                    var data = google.visualization.arrayToDataTable(dataArray);
                    data.setColumnProperty(2, 'role', 'tooltip');
                    data.setColumnProperty(2, 'html', true);

                    var options = {
                        title: ' ', width: w, height: h,
                        chartArea: { left: 0, top: 10, width: w, height: h - 10 },
                        tooltip: { isHtml: true },
                        pieSliceText: 'value-and-percentage',
                        legend: { textStyle: { fontSize: 11 } }
                    };
                    new google.visualization.PieChart(document.getElementById('piechart')).draw(data, options);
                }
            });
        }

        function customTooltip(name, value, total) {
            return name + '<br/><b>' + value + ' (' + ((value / total) * 100).toFixed(1) + '%)</b>';
        }
        function getTotal(dataArray) {
            return dataArray.reduce(function (s, r) { return s + r[1]; }, 0);
        }
    </script>
}


