<div class="modal fade" data-backdrop="static" data-keyboard="false" id="lessonModal" tabindex="-1" role="dialog" aria-labelledby="lessonModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header clearfix">
                <h5 class="modal-title">Add Lession</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <input id="lessonId" name="lessonId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="SubjectLesson">Subject</label>
                            <select id="SubjectLesson" name="SubjectLesson" placeholder="Enter Subject" type="text" value="" class="form-control input-sm" style="min-width: 100%">
                                <option value="">Select lession</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="lessionSub">Lession's Name</label>
                            <input id="lessionSub" name="lessionSub" placeholder="Enter lession" type="text" value="" class="form-control input-sm" style="min-width: 100%" />
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        <div id="overflowTable" style="overflow-x: auto;">
                            <table id="LessionTable" class="table table-hover table-bordered" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th style="width: 35px">ID</th>
                                        <th>Subject's Name</th>
                                        <th>Lession</th>
                                        <th style="width: 90px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
                <button type="button" id="btnLessionAction" onclick="LessionAction()" class="btn btn-primary btn-sm">Save changes</button>
            </div>
        </div>

    </div>
</div> <!-- modal -->
