                                <a class="ctab-item" role="tab" data-bs-toggle="pill" href="#client-placement" id="placementTab">
                                    <i class="fa fa-map-marker"></i>
                                    <span>Placement</span>
                                </a>
                                <a class="ctab-item" role="tab" data-bs-toggle="pill" href="#futures-training" id="futuresTrainingTab">
