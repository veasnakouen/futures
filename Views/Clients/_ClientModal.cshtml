                                                        <input id="registerdateClientnd" name="registerdateClientnd" placeholder="Enter register date" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="registerdateClientrd">Register's date 3rd</label>
                                                        <input id="registerdateClientrd" name="registerdateClientrd" placeholder="Enter register date" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="expextedsupport">Expected Support from future</label>
                                                        <select class="form-control form-control-sm" id="expextedsupport">
                                                            <option value="">Please select option </option>
                                                            <option value="furthereducation ">Further Education </option>
                                                            <option value="placement">Placement</option>
                                                            <option value="futurestraining">Futures Training</option>
                                                            <option value="socialsupport">Social Support</option>
                                                            <option value="Self-employment">Self-employment</option>
                                                            <option value="apprenticeship">Apprenticeship</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="checkbox">
                                                        <label><input id="furtherEducation" type="checkbox" value="">Further Education (Meeting with social worker)</label>
                                                    </div>

                                                    <div class="checkbox">
                                                        <label><input id="placement" type="checkbox" value="">Placement (Skills assessment)</label>
                                                    </div>

                                                    <div class="checkbox">
                                                        <label><input id="futuresTraining" type="checkbox" value="">Futures Training</label>
                                                    </div>

                                                    <div class="checkbox">
                                                        <label><input id="socialSupport" type="checkbox" value="">Social Support</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />

                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label for="hearBy">Where did you hear about Futures?</label>
                                                        <select class="form-control form-control-sm" id="hearBy">
                                                            <option>Internet</option>
                                                            <option>Social Media</option>
                                                            <option>Radio</option>
                                                            <option>Newspaper</option>
                                                            <option>Friend</option>
                                                            <option>Teacher</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />

                                            <div class="row">
                                                <div class="col-md-12">
                                                    <label for="HaveProblemCase">Does the client a problem? </label>
                                                    <div class="form-group">
                                                        <label class="radio-inline col-md-4">
                                                            <input type="radio" name="HaveProblemCase" id="NohaveProblemCase" checked value="NohaveProblem">No Have Problem
                                                        </label>
                                                        <label class="radio-inline col-md-4">
                                                            <input type="radio" name="HaveProblemCase" id="HaveProblemCase" value="HaveProblem">Have Problem
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <hr />

                                            <div class="row">
                                                <div class="col-md-12">
                                                    <label for="ClientidpoorStatus">Id Poor status </label>
                                                    <div class="form-group">
                                                        <label class="radio-inline col-md-3">
                                                            <input type="radio" name="clientidpoorStatus" id="ClientidpoorStatusNohave" checked value="Nohave">No have
                                                        </label>
                                                        <label class="radio-inline col-md-3">
                                                            <input type="radio" name="clientidpoorStatus" id="ClientidpoorStatusIsValid" value="IsValid">Is Valid
                                                        </label>
                                                        <label class="radio-inline col-md-3">
                                                            <input type="radio" name="clientidpoorStatus" id="ClientidpoorStatusExpired" value="Expired">Expired
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <br />

                                            <div class="row">

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="ClientIdpoorvalidDate">Id poor valid date</label>
                                                        <input id="ClientIdpoorvalidDate" name="ClientIdpoorvalidDate" placeholder="Enter Date of birth" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                            </div>


                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="ClientIdpoorlevel">Id poor level</label>
                                                        <select class="form-control form-control-sm" id="clientIdpoorlevel" name="clientIdpoorlevel">
                                                            <option value="">Please select option</option>
                                                            <option value="Level 1 ">Level 1 </option>
                                                            <option value="Level 2">Level 2</option>
                                                        </select>
                                                    </div>
                                                </div>



                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="ClientIdpooraccountnumber">Id poor account number</label>
                                                        <input id="ClientIdpooraccountnumber" name="ClientIdpooraccountnumber" placeholder="Enter Id poor account number" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Upload Id Card</label>
                                                        <input onchange="readURLIdCard(this);" type="file" name="fileIdCard" id="fileIdCard" style="width: 100%;" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- col-md-8 -->
                                </div>
                                <!-- panel-body -->

                            </div> <!-- inner panel -->

                        </div> <!-- col-md-4 -->

                        <div class="col-md-8">

                            <div class="client-tab-menu" role="tablist">
                                <span class="client-tab-slider"></span>

                                <a class="ctab-item" role="tab" data-bs-toggle="pill" href="#case-management" id="caseManagementTab">
