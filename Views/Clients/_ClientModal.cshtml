                                    <span>Case Management</span>
                                </a>
                                <a class="ctab-item" role="tab" data-bs-toggle="pill" href="#further-education" id="furtherEducationTab">
                                    <i class="fa fa-graduation-cap"></i>
                                    <span>Further Education</span>
                                </a>
                                <a class="ctab-item" role="tab" data-bs-toggle="pill" href="#education" id="educationTab">
                                    <i class="fa fa-book"></i>
                                    <span>Education</span>
                                </a>
                                <a class="ctab-item" role="tab" data-bs-toggle="pill" href="#job-specification" id="jobSpecificationTab">
