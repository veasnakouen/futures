                            <!--All function-->
                            <div class="tab-content">
                                <!--case-management-->
                                <div id="case-management" class="tab-pane fade show active">
                                    <div class="panel panel-default">
                                        <div class="panel-heading">
                                            <span>Case Information</span>
                                            <div class="d-flex gap-2">
                                                <button type="button" data-bs-toggle="modal" data-bs-target="#caseWorkerModal" class="btn btn-success btn-sm" style="color:white;"><i class="fa fa-plus"></i> Add Case Worker</button>
                                                <button type="button" data-bs-toggle="modal" data-bs-target="#caseModal" class="btn btn-success btn-sm" style="color:white;"><i class="fa fa-plus"></i> Add New</button>
                                            </div>
                                        </div>
