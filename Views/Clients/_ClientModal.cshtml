                                                        <input id="clientHeights" name="clientHeights" placeholder="Enter Height" type="text" style="display: none;" disabled="disabled" value="NONE" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        @*<label for="clientWeights">Weight</label>*@
                                                        <input id="clientWeights" name="clientWeights" placeholder="Enter Weight" type="text" style="display: none;" disabled="disabled" value="NONE" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
