                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="address">Address</label>
                                                        <input id="address" name="address" placeholder="Enter address" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="clientplaceOfBirth">Place of birth</label>
                                                        <input id="clientplaceOfBirth" name="clientplaceOfBirth" placeholder="Enter place of birth" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="clientNationality">Nationality</label>
                                                        <input id="clientNationality" name="clientNationality" placeholder="Enter Nationality" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="clientCitizenship">Citizenship</label>
                                                        <input id="clientCitizenship" name="clientCitizenship" placeholder="Enter Citizenship" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="currentSituation">Current Situation</label>
                                                        <select class="form-control form-control-sm" id="currentSituation">
                                                            <option>Unemployed</option>
                                                            <option>Employed</option>
                                                            <option>Self-employed</option>
                                                            <option>Family worker</option>
                                                            <option>VT Student</option>
                                                            <option>University Student</option>
                                                            <option>Seasonal</option>
                                                            <option>Other</option>
                                                        </select>
                                                    </div>
                                                </div>
