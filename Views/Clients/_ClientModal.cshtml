                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label for="relativePhone">Relative Phone</label>
                                                        <input id="relativePhone" name="relativePhone" placeholder="Enter relative phone" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
