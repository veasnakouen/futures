<form id="clients" method="post" enctype="multipart/form-data">
    <div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="clientModal" tabindex="-1" role="dialog" aria-labelledby="clientModal" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">

