                                                </div>

                                                <div class="form-group">
                                                    <label>Upload Photo</label>
                                                    <input onchange="readURL(this);" type="file" name="file" id="file" style="width: 100%;" />
                                                </div>
                                            </div>


                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="row">
                                                <div class="col-md-6">
