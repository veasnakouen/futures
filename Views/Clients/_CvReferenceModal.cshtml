
<div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="cvReferenceModal" tabindex="-1" role="dialog" aria-labelledby="cvReferenceModal" aria-hidden="true">

    <div class="modal-dialog" role="document">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-address-card me-2"></i>Job Reference</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="row">

                    <input id="cvReferenceId" name="cvReferenceId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="cvReferenceName">Name </label>
                            <input id="cvReferenceName" name="cvReferenceName" placeholder="Enter employer" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="cvReferencePositionId">Job Position</label>
                            <select class="form-control form-control-sm" id="cvReferencePositionId" name="cvReferencePositionId" style="min-width: 100%">
                                @foreach (var jobPosition in Model.JobPositions)
                                {
                                    <option value=@jobPosition.Id>@jobPosition.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="cvReferenceOrganization">Organization </label>
                            <input id="cvReferenceOrganization" name="cvReferenceOrganization" placeholder="Enter Organization" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="cvReferencePhone">Phone</label>
                            <input id="cvReferencePhone" name="cvReferencePhone" placeholder="Enter Phone" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="cvReferenceEmail">Email</label>
                            <input id="cvReferenceEmail" name="cvReferenceEmail" placeholder="Enter email" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="cvReferenceDescription">Description </label>
                            <input id="cvReferenceDescription" name="cvReferenceDescription" placeholder="Enter Description" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" onclick="cvReferenceAction();" id="btncvReferenceAction" class="btn btn-primary btn-sm">Add New</button>
            </div>
        </div>

    </div>
</div>