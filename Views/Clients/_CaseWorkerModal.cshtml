

<div class="modal fade" data-backdrop="static" data-keyboard="false" id="caseWorkerModal" tabindex="-1" role="dialog" aria-labelledby="caseWorkerModal" aria-hidden="true">
    <div class="modal-dialog" role="document">

        <div class="modal-content">
            <div class="modal-header clearfix">
                <h5 class="modal-title">Case Worker</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <input id="caseWorkerId" name="caseWorkerId" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="caseWorkerName">Case Worker's Name</label>
                            <input id="caseWorkerName" name="caseWorkerName" placeholder="Enter case worker's name'" type="text" value="" class="form-control input-sm" style="min-width: 100%" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="Program">Program</label>
                            <select class="form-control input-sm" id="Program" name="Program" style="min-width: 100%">
                                <option value="Futures">Futures</option>
                                <option value="ChildProtection">Child Protection</option>
                                <option value="DropIn">Drop In</option>
                                <option value="Outreach">Outreach</option>
                                <option value="Drug">Drug</option>
                                <option value="VTC">VTC</option>
                                <option value="Back to school">Back to school</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="caseWorkerStatus">Status</label>
                            <select class="form-control input-sm" id="caseWorkerStatus">
                                <option>Active</option>
                                <option>Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        <div id="overflowTable" style="overflow-x: auto;">
                            <table id="caseWorkerTable" class="table table-hover table-bordered" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th style="width: 35px">ID</th>
                                        <th>Case Worker's Name</th>
                                        <th>Program</th>
                                        <th>Status</th>
                                        <th style="width: 90px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
                <button type="button" id="btnCaseWorkerAction" onclick="CaseWorkerAction()" class="btn btn-primary btn-sm">Save changes</button>
            </div>
        </div>

    </div>
</div> <!-- modal -->
