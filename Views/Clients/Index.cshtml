@model MtpApp.ViewModels.ClientViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="fa fa-users me-2"></i>
            <span class="fw-semibold">Manage Clients</span>
            <button onclick="clearForm();" data-bs-toggle="modal" data-bs-target="#clientModal" class="btn btn-success btn-sm ms-auto">
                <i class="fa fa-plus me-1"></i> Add Client
            </button>
        </div>
        <div class="card-body p-2">
            <div style="overflow-x: auto;">
                <table id="clients" class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 35px">ID</th>
                            <th>Client code</th>
                            <th>Client's name</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Contact Phone</th>
                            <th>Province</th>
                            <th>Assessed Duration</th>
                            <th style="width: 160px;">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>


@Html.Partial("_ClientModal")
@Html.Partial("_ReferralEducation")
@Html.Partial("_ReferralSource")
@Html.Partial("_JobExperienceModal")
@Html.Partial("_EducationHistoryModal")
@Html.Partial("_LanguageModal")
@Html.Partial("_ComputerSkillModal")
@Html.Partial("_CaseWorkerModal")
@Html.Partial("_CaseModal")
@Html.Partial("_PlacementModal")
@Html.Partial("_SubjectModal")
@Html.Partial("_FuturesTrainingModal")
@Html.Partial("_SocialSupportModel")
@Html.Partial("_BusinessSetUpCategory")
@Html.Partial("_BusinessSetUp")
@Html.Partial("_MonitoringModal")
@Html.Partial("_LessionModal")
@Html.Partial("_MonitoiringChoicesModal")   
@Html.Partial("_FutureTrainingMonitoringModal")
@Html.Partial("_FutureTrainingMonitoringActionModal")
@Html.Partial("_PlacementMonitoringModal")
@*@Html.Partial("_placementMonitoringActionModal")*@
@Html.Partial("_SocialSupportCaseModel")
@Html.Partial("_businessSetupMonitoringModal")
@Html.Partial("_BusinessSetupMonitoringActionModal")
@Html.Partial("_CvReferenceModal")
@Html.Partial("_CvViewerModal")

@section scripts
{
    @Scripts.Render("~/Scripts/Functions/client.js")
    @Scripts.Render("~/Scripts/Functions/furthereducation.js")
    @Scripts.Render("~/Scripts/Functions/beneficiary.js")
    @Scripts.Render("~/Scripts/Functions/referralsource.js")
    @Scripts.Render("~/Scripts/Functions/referraleducation.js")
    @Scripts.Render("~/Scripts/Functions/jobexpectation.js")
    @Scripts.Render("~/Scripts/Functions/jobexperience.js")
    @Scripts.Render("~/Scripts/Functions/educationhistory.js")
    @Scripts.Render("~/Scripts/Functions/language.js")
    @Scripts.Render("~/Scripts/Functions/computerskill.js")
    @Scripts.Render("~/Scripts/Functions/personality.js")
    @Scripts.Render("~/Scripts/Functions/caseworker.js")
    @Scripts.Render("~/Scripts/Functions/case.js")
    @Scripts.Render("~/Scripts/Functions/placement.js")
    @Scripts.Render("~/Scripts/Functions/subject.js")
    @Scripts.Render("~/Scripts/Functions/futurestraining.js")
    @Scripts.Render("~/Scripts/Functions/socialsupport.js")
    @Scripts.Render("~/Scripts/Functions/socialcare.js")
    @Scripts.Render("~/Scripts/Functions/businesssetupcategory.js")
    @Scripts.Render("~/Scripts/Functions/businesssetup.js")
    @Scripts.Render("~/Scripts/Functions/monitoring.js")
    @Scripts.Render("~/Scripts/Functions/lession.js")    
    @Scripts.Render("~/Scripts/Functions/futuretrainingmonitoring.js")  
    @Scripts.Render("~/Scripts/Functions/placementmonitoring.js")
    @Scripts.Render("~/Scripts/Functions/socialsupportCase.js")
    @Scripts.Render("~/Scripts/Functions/businessSetupmonitoring.js")
    @Scripts.Render("~/Scripts/Functions/cvReference.js")
 
    <script>
        $(document).ready(function () {

            GetClients();

            TabChanged();

            HideTab();

            ageCalculation();

            $('#clientModal').on('shown.bs.modal', function () {
                // Position slider on the initially-active tab after the modal is visible
                // (offsetLeft is zero while the modal is hidden)
                var $active = $('.client-tab-menu .ctab-item.active');
                if (!$active.length) $active = $('.client-tab-menu .ctab-item').first();
                moveTabSlider($active);
            });

            $('#clientModal').on('show.bs.modal', function () {

                activateTab('case-management');
                if ($('#id').val().trim() == "") {

                    $('#EducationHistoryTable').dataTable().fnClearTable();
                    $('#languageTable').dataTable().fnClearTable();
                    $('#computerSkillTable').dataTable().fnClearTable();

                    $('#strength').val('');
                    $('#weakness').val('');
                    //toastr.error("You must create client first.", "Server Response");
                }
                else {
                    // Load case table for the current client
                    var caseClientId = parseInt($('#id').val()) || 0;
                    if (caseClientId > 0) {
                        console.log('Modal opened, loading cases for client:', caseClientId);
                        if (typeof RefreshCasesTable === 'function') {
                            RefreshCasesTable(caseClientId);
                        } else {
                            GetCaseByClientId(caseClientId);
                        }
                    }
                    
                    getEducationHistories();
                    getLanguages();
                    getComputerSkill();
                    GetPersonalitiesByClientId($('#id').val());
                    GetCaseByClientId($('#id').val());
                    GetBusinessSetUpByClientId($('#id').val());
                    GetPlacementByClientId($('#id').val());
                }
            });

            $('#subjectModal').on('show.bs.modal', function () {
                GetSubjects();
                document.getElementById('subjectName').disabled = true;
                document.getElementById('btnSubjectAction').innerText = "Add New";
                $('#subjectName').val('');
            });

            $('#lessonModal').on('show.bs.modal', function () {
                GetLessions();
                document.getElementById('SubjectLesson').disabled = true;
                document.getElementById('lessionSub').disabled = true;
                document.getElementById('btnLessionAction').innerText = "Add New";
                $('#lession').val('');
                document.getElementById("SubjectLesson").selectedIndex = "0";
            });

          

            $(".ctab-item").on('click', function () {
                var href = $(this).attr('href');
                moveTabSlider($(this));
                if (href == "#case-management") {
                    var caseClientId = parseInt($('#clientModal #id').val()) || parseInt($('#caseModal #clientId').val()) || 0;
                    if (!caseClientId) {
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        if (typeof RefreshCasesTable === 'function') {
                            RefreshCasesTable(caseClientId);
                        } else {
                            GetCaseByClientId(caseClientId);
                        }
                    }
                }
                else if (href == "#beneficiary") {
                    if ($('#id').val().trim() == "") {
                        tableBeneficiary.clear().draw();
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetBeneficiariesByClientId($('#id').val());
                    }
                }
                else if (href == "#further-education") {
                    if ($('#id').val().trim() == "") {
                        tableReferralEducation.clear().draw();
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetFurtherEducationByClientId($('#id').val());
                        GetReferralSources();
                        GetReferralEducation();
                    }
                }
                else if (href == "#education") {
                    if ($('#id').val().trim() == "") {
                        $('#strength').val('');
                        $('#weakness').val('');
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        getEducationHistories();
                        getLanguages();
                        getComputerSkill();
                        GetPersonalitiesByClientId($('#id').val());
                    }
                }
                else if (href == "#job-specification") {
                    if ($('#id').val().trim() == "") {
                        $('#jobExpectationId').val('');
                        $('#jobExpectationAvailableTime').val('');
                        $('#salaryExpectation').val('');
                        $('#jobExpectationNote').val('');
                        $('#jobPositionId1').val('');
                        $('#jobPositionId2').val('');
                        $('#jobPositionId3').val('');
                        $('#jobCategoryId1').val('');
                        $('#jobCategoryId2').val('');
                        $('#jobCategoryId3').val('');
                        $('#employmenttype').val('');
                        $('#jobExpectationCandidate').val('');
                        $('#jobExpectationHobby').val('');
                        $('#permanent').prop('checked', false);
                        $('#temporary').prop('checked', false);
                        $('#seasonal').prop('checked', false);
                        tableJobExperience.clear().draw();
                        tablecvReference.clear().draw();
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetJobExpectationByClientId($('#id').val());
                        getJobExperiences();
                        getcvReference();
                    }
                }
                else if (href == "#client-placement") {
                    if ($('#id').val().trim() == "") {
                        tableBusinessSetUps.clear().draw();
                        tablePlacements.clear().draw();
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetBusinessSetUpByClientId($('#id').val());
                        GetPlacementByClientId($('#id').val());
                    }
                }
                else if (href == "#futures-training") {
                    if ($('#id').val().trim() == "") {
                        tableFuturesTraining.clear().draw();
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetFuturesTrainingsByClientId($('#id').val());
                    }
                }
                else if (href == "#social-support") {
                    if ($('#id').val().trim() == "") {
                        tableSocialSupportCase.clear().draw();
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetSocialSupportCasesByClientId($('#id').val());
                    }
                }
                else if (href == "#monitoring") {
                    if ($('#id').val().trim() == "") {
                        toastr.error("You must create client first.", "Server Response");
                    } else {
                        GetMonitoringByClientId($('#id').val());
                    }
                }
            });

            // Keep slider in sync whenever Bootstrap activates a tab (any method)
            $(document).on('show.bs.tab', '.ctab-item', function () {
                moveTabSlider($(this));
            });
            $(document).on('hidden.bs.modal', function () {
                $('body').addClass('modal-open');
            });

            $('#clients').on('length.dt', function (e, settings, len) {
                $("body").removeClass('modal-open');
            });

            $('#referralSource').on('show.bs.modal', function () {
                $('#referralSourceName').css('border-color', '#cccccc');
                $('#origin').css('border-color', '#cccccc');
                document.getElementById('referralSourceName').disabled = true;
                document.getElementById('origin').disabled = true;
                document.getElementById('btnReferralAction').innerText = "Add New";
                $('#referralSourceName').val('');
            });

            $('#caseWorkerModal').on('show.bs.modal', function () {
                $('#caseWorkerName').css('border-color', '#cccccc');
                $('#caseWorkerStatus').css('border-color', '#cccccc');
                $('#Program').css('border-color', '#cccccc');
                GetCaseWorkers();
                document.getElementById('caseWorkerName').disabled = true;
                document.getElementById('Program').disabled = true;
                document.getElementById('caseWorkerStatus').disabled = true;
                document.getElementById('btnCaseWorkerAction').innerText = "Add New";
                $('#caseWorkerName').val('');
            });

            $('#jobExperienceModal').on('show.bs.modal', function () {
                resetFormJobExperience();
                disableForm();
                document.getElementById('btnJobExperienceAction').innerText = "Add New";
            });


            $('#cvReferenceModal').on('show.bs.modal', function () {
                resetFormReferecnce();
                disableFormReferecnce();
                document.getElementById('btncvReferenceAction').innerText = "Add New";
            });

            $('#EducationHistoryModal').on('show.bs.modal', function () {
                resetFormEducationHistory();
                disableFormEducationHistory();
                document.getElementById('btnEducationHistoryAction').innerText = "Add New";
            });

            $('#LanguageModal').on('show.bs.modal', function () {
                resetFormLanguage();
                disableFormLanguage();
                document.getElementById('btnLanguageAction').innerText = "Add New";
            });

            $('#ComputerSkillModal').on('show.bs.modal', function () {
                resetFormComputerSkill();
                disableFormComputerSkill();
                document.getElementById('btnComputerSkillAction').innerText = "Add New";
            });
        });




        //function ClientCloseForm() {
        //    $('body').addClass('modal-open');

        //    alert("HI");
        //}


        function activateTab(tab) {
            var $item = $('.ctab-item[href="#' + tab + '"]');
            if ($item.length) {
                if (window.bootstrap && window.bootstrap.Tab) {
                    window.bootstrap.Tab.getOrCreateInstance($item[0]).show();
                } else if (typeof $item.tab === 'function') {
                    $item.tab('show');
                }
            }
            // Move slider on programmatic activation too
            if ($item.length) moveTabSlider($item);
        };

        function ageCalculation() {
            $('#dateOfBirth').change(function () {
                $('#age').val('');
                var currentDate = new Date();
                var year = new Date($('#dateOfBirth').val());
                var age = currentDate.getFullYear() - year.getFullYear();
                var value = Number(age) + ' years old';
                $('#age').val(value);
            });
        }

        function TabChanged() {
            // Bootstrap 5 already handles tab activation via data-bs-toggle="pill";
            // we just keep this for any legacy .tab('show') calls.
        }

        function moveTabSlider($item) {
            var $menu = $item.closest('.client-tab-menu');
            if (!$menu.length) return;
            $menu.find('.ctab-item').removeClass('active');
            $item.addClass('active');
            $menu.find('.client-tab-slider').css({
                left:  $item[0].offsetLeft  + 'px',
                width: $item[0].offsetWidth + 'px'
            });
        }

        function HideTab() {
            $('#furtherEducation').change(function () {
                if ($(this).is(':checked')) {
                    $('#furtherEducationTab').show();
                } else {
                    $('#furtherEducationTab').hide();
                };
            });

            $('#placement').change(function () {
                if ($(this).is(':checked')) {
                    $('#placementTab').show();
                    //$('#educationTab').show();
                    $('#jobSpecificationTab').show();
                    $('#beneficiaryTab').show();
                } else {
                    $('#placementTab').hide();
                    //$('#educationTab').hide();
                    $('#jobSpecificationTab').hide();
                    $('#beneficiaryTab').hide();
                };
            });

            $('#futuresTraining').change(function () {
                if ($(this).is(':checked')) {
                    $('#futuresTrainingTab').show();
                } else {
                    $('#futuresTrainingTab').hide();
                };
            });

            $('#socialSupport').change(function () {
                if ($(this).is(':checked')) {
                    $('#socialSupportTab').show();
                } else {
                    $('#socialSupportTab').hide();
                };
            });
        }
    </script>
}