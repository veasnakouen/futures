@using ReportViewerForMvc;

<div class="container-fluid pt-3">

    <div class="report-filter-bar">
        <div class="col-md-2">
                <div class="form-group ">
                    <div class="dropdown">
                        <select class="form-control input-sm btn btn-primary btn-sm dropdown-toggle" id="JobVancancyStatus" name="JobVancancyStatus" style="min-width: 100%">
                            <option value="Open">Open</option>
                            <option value="Open and not yet Deadline">Open and not yet Deadline</option>
                            <option value="Close">Close</option>
                        </select>
                    </div>
                </div>
            @*<div class="col-md-5">
                <div class="form-group">
                    <div class="dropdown">
                        <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            Filter by Gender
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Show All", "job-readiness-report/gender=all/startdate=null/enddate=null", "clients")</li>
                            <li>@Html.ActionLink("Female", "job-readiness-report/gender=female/startdate=null/enddate=null", "clients")</li>
                            <li>@Html.ActionLink("Male", "job-readiness-report/gender=male/startdate=null/enddate=null", "clients")</li>
                        </ul>
                    </div>
                </div>
            </div>*@
        </div>
        
        <div class="col-md-4">
            <div class="col-md-3">
                <div class="form-group">
                    <input id="startDate" name="startDate" placeholder="Start Date" type="text" value="" class="form-control input-sm js-date" style="width: 100%" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <input id="endDate" name="endDate" placeholder="End Date" type="text" value="" class="form-control input-sm js-date" style="width: 100%" />
                </div>
            </div>
            <div class="col-md-3">
                <button onclick="filterByAssessedDate();" class="btn btn-primary btn-sm btn-block">
                    <i class="fa fa-search me-1"></i> Search
                </button>
            </div>
        </div>
    </div>
    
    @Html.ReportViewer(ViewBag.ReportViewer as Microsoft.Reporting.WebForms.ReportViewer)

</div>

@section scripts
{
    <script>
        function filterByAssessedDate()
        {
            var start = $('#startDate').val();
            var end = $('#endDate').val();

            if (start == '' || end == '') {
                toastr.error("Please enter required field.");
                $('#startDate').css('border-color', 'red');
                $('#endDate').css('border-color', 'red');
            }
            else
            {
                $('#startDate').css('border-color', '#cccccc');
                $('#endDate').css('border-color', '#cccccc');
                var url = "/clients/job-vancancy-available-report/status=" + $('#JobVancancyStatus').val() + "/startdate=" + moment($('#startDate').val()).format('MM-DD-YYYY') + "/enddate=" + moment($('#endDate').val()).format('MM-DD-YYYY');
                window.location.href = url;
            }
        }

        $(function () {
            $(".js-date").datepicker({
                dateFormat: 'mm/dd/yy',
                changeMonth: true,
                changeYear: true,
                yearRange: '1950:2100'
            });
        });
    </script>
}

