<div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="FuturestrainingModal" tabindex="-1" role="dialog" aria-labelledby="caseModal" aria-hidden="true">

        <div class="modal-dialog modal-lg" role="document">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-chalkboard-user me-2"></i>Add New Futures Training</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row">

                        <input id="futuresTrainingId" name="futuresTrainingId" type="text" style="display: none;" disabled="disabled" value="Testing" class="form-control" />
                        <input id="futurestrainingStatus" name="futurestrainingStatus" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="subjectId-Name">Subject-Name</label>

                                <select class="form-control form-control-sm" id="subjectId-Name" name="subjectId-Name" style="min-width: 100%">
                                    <option></option>
                                </select>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="openDateFuturesTraining">OpenDate</label>
                                <input id="openDateFuturesTraining" name="openDateFuturesTraining" placeholder="Enter open date" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <label for="futurestrainingStatus" style="display: none;" disabled="disabled" value="">Status</label>
                               
                         <div class="col-md-6">
                                 <div class="form-group">
                                     <label for="futurestrainingNote">Available time</label> <!-- Change note to Available time-->
                                     <input id="futurestrainingNote" name="futurestrainingNote" placeholder="Enter Available time" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                                 </div>
                        </div>


                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="closeDateFuturesTraining">CloseData</label>
                                <input id="closeDateFuturesTraining" name="closeDateFuturesTraining" placeholder="Enter close date" type="text" value="" class="form-control input-sm js-date" style="min-width: 100%" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" onclick="FuturestrainingAction();" id="btnFuturestrainingAction" class="btn btn-primary btn-sm">Add New</button>
                </div>

            </div>

        </div>
 </div>
