@{
    ViewBag.Title = "Advanced Report Viewer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Full height container to accommodate the React App */
    .report-viewer-container {
        width: 100%;
        height: calc(100vh - 120px); /* Adjust based on your main layout's header/footer height */
        min-height: 800px;
        margin-top: 15px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .report-viewer-iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2 class="mt-3">@ViewBag.Title</h2>
            <div class="report-viewer-container">
                <iframe class="report-viewer-iframe" src="/viewer/index.html" title="RDLC React Viewer"></iframe>
            </div>
        </div>
    </div>
</div>
