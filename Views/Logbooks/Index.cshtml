
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="fa fa-book-open me-2"></i>
            <span>Manage Log Books</span>
            <button data-bs-toggle="modal" data-bs-target="#LookbookModal" class="btn btn-success btn-sm ms-auto">
                <i class="fa fa-plus me-1"></i> Add Log Book
            </button>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x: auto;">
                <table id="LogbookTable" class="table table-hover table-bordered mb-0">
                    <thead>
                        <tr>
                            <th style="width: 35px">ID</th>
                            <th>Gender</th>
                            <th>Phone</th>
                            <th>Note</th>
                            <th>Information</th>
                            <th>Library</th>
                            <th>Using computer</th>
                            <th>Copy/Print</th>
                            <th>Training for interview</th>
                            <th>Access by</th>
                            <th>Access date</th>
                            <th style="width: 90px;">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

@Html.Partial("_addLogBookModal")

@section scripts
{
    <script src="~/Scripts/Functions/logbook.js"></script>
}








