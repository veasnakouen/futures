
@{
    ViewBag.Title = "Index";
}

<div class="card">
    <div class="card-header bg-dark text-white d-flex align-items-center">
        <i class="fa fa-tags me-2"></i>
        <span>Manage Categories</span>
        <button onclick="clearForm();" type="button" data-bs-toggle="modal" data-bs-target="#categoryModal" class="btn btn-primary btn-sm ms-auto"><i class="fa fa-plus me-1"></i> Add Category</button>
    </div>
    <div class="card-body p-0">
        <table id="categories" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Category</th>
                    <th style="width: 150px;">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<form id="formCategory" method="post">
    <div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="categoryModal" tabindex="-1" role="dialog" aria-labelledby="categoryModal" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-tags me-2"></i>Category</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">

                    <input id="id" name="id" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                    <div class="mb-3">
                        <label class="form-label">Category name</label>
                        <input id="name" name="name" placeholder="Enter category name" type="text" value="" class="form-control" />
                    </div>

                    <div id="loaderDiv" style="text-align:center; display:none;">
                        <img src="~/Content/InternetSlowdown_Day.gif" width="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" id="btnUpdate" class="btn btn-primary btn-sm js-update" onclick="Update();">Update</button>
                    <button type="button" id="btnSave" class="btn btn-success btn-sm" onclick="Save();">Save</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section scripts
{
    <script>
        $(document).ready(function () {
            GetCategories();

            $('#categoryModal').on('shown.bs.modal', function () {
                $('#name').focus();
            });
        });

        var table = [];

        function GetCategories() {
            table = $('#categories').DataTable({
                ajax: {
                    url: "/api/categories",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return "<a href='#' onclick='Edit(" + data + ")'><i class='fa fa-pencil'></i> Edit</a>" + " | " + "<a href='#' onclick='Delete(" + data + ")'><i class='fa fa-trash'></i> Delete</a>";
                        }
                    }
                ]
            });
        }

        //Update
        function Update() {
            var res = validate();
            if (res === false) {
                return false;
            }

            $("#loaderDiv").show();

            var data = {
                id: $('#id').val(),
                name: $('#name').val()
            };

            $.ajax({
                url: "/api/categories/" + data.id,
                data: JSON.stringify(data),
                type: "PUT",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (data) {
                    toastr.success("Category has been updated.");
                    $('#id').val("");
                    $('#name').val("");
                    table.ajax.reload();
                    $("#loaderDiv").hide();
                    $('#categoryModal').modal('hide');
                },
                error: function (errormessage) {
                    console.log(errormessage);
                    toastr.error("Something unexpected happen.");
                }
            });
        }

        //Edit
        function Edit(id) {

            $("#name").css('border-color', '#cccccc');

            $.ajax({
                url: "/api/categories/" + id,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                success: function (result) {
                    $('#id').val(result.id);
                    $('#name').val(result.name);

                    $('#categoryModal').modal('show');
                    $('#btnUpdate').show();
                    $('#btnSave').hide();
                },
                error: function (errormessage) {
                    toastr.error("Something unexpected happen.");
                }
            });
            return false;
        }

        //Save
        function Save() {
            var res = validate();
            if (res === false) {
                return false;
            }

            $("#loaderDiv").show();

            var data = {
                name: $('#name').val()
            };

            $.ajax({
                url: "/api/categories",
                data: JSON.stringify(data),
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    toastr.success("Category has been added to the database.");
                    $('[name="name"]').val('');
                    table.ajax.reload();
                    $("#loaderDiv").hide();
                    $('#categoryModal').modal('hide');
                },
                error: function (errormessage) {
                    toastr.error("Something unexpected happen.");
                }
            });
        }

        //Delete
        function Delete(id) {
            bootbox.confirm("Are you sure you want to delete this?", function (result) {
                if (result) {
                    $.ajax({
                        url: "/api/categories/" + id,
                        method: "DELETE",
                        success: function () {
                            table.ajax.reload();
                            toastr.success("Deleted successfully.", "Server Response");
                        }
                    });
                }
            });
        }

        //ClearModalInput
        function clearForm() {
            $('#id').val('');
            $('#name').val('');
            $('#btnUpdate').hide();
            $('#btnSave').show();
            $('#id').css('border-color', '#cccccc');
            $('#name').css('border-color', '#cccccc');
        }

        //Validate
        function validate() {
            var isValid = true;
            if ($('#name').val().trim() == "") {
                $('#name').css('border-color', 'red');
                $('#name').focus();
                isValid = false;
            } else {
                $('#name').css('border-color', '#cccccc');
            }

            return isValid;
        }
    </script>
}