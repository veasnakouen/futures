        function validate() {
            var isValid = true;
            if ($('#idNo').val().trim() == "") {
                $('#idNo').css('border-color', 'red');
                $('#idNo').focus();
                isValid = false;
            } else {
                $('#idNo').css('border-color', '#cccccc');
                if ($('#title').val().trim() == "") {
                    $('#title').css('border-color', 'red');
                    $('#title').focus();
                    isValid = false;
                } else {
                    $('#title').css('border-color', '#cccccc');
                    if ($('#firstNameEnglish').val().trim() == "") {
                        $('#firstNameEnglish').css('border-color', 'red');
                        $('#firstNameEnglish').focus();
                        isValid = false;
                    } else {
                        $('#firstNameEnglish').css('border-color', '#cccccc');
                        if ($('#lastNameEnglish').val().trim() == "") {
                            $('#lastNameEnglish').css('border-color', 'red');
                            $('#lastNameEnglish').focus();
                            isValid = false;
                        } else {
                            $('#lastNameEnglish').css('border-color', '#cccccc');
                            if ($('#positionId').val().trim() == "") {
