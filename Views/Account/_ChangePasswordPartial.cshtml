@using MtpApp.Models
@model MtpApp.Models.ManageUserViewModel

<div class="row pt-4">
    <div class="col-md-4 offset-md-4">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <i class="fa fa-key me-2"></i>Change Password
            </div>
            <div class="card-body">
                <section id="changePasswordForm">
                    @using (Html.BeginForm("Manage", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control input-sm focus", @placeholder = "Current Password" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control input-sm", @placeholder = "New Password" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control input-sm", @placeholder = "Confirm New Password" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-12">
                                <input type="submit" value="Change password" class="btn btn-default btn-block btn-sm" />
                            </div>
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
</div>

