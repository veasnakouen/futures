
<div class="modal fade" id="jobDetail" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-briefcase me-2"></i>Job Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input id="id" name="id" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                <h4 style="color: #004973"><span id="positionDisplay"></span></h4>
                <hr />
                <p><b id="dateDisplay"></b></p>
                <hr />
                <p><i class="fa fa-location-dot"></i> <b>Location: </b><span id="locationDisplay"></span></p>
                <p><i class="fa fa-calendar"></i> <b>Schedule: </b><span id="scheduleDisplay"></span></p>
                <p><i class="fa fa-dollar-sign"></i> <b>Salary: </b><span id="salaryDisplay"></span></p>
                <p><i class="fa fa-list"></i> <b>Contract: </b><span id="contractDisplay"></span></p>
                <hr />
                <p><h5 style="color: #004973">Responsibilities:</h5></p>
                <p id="responsibilitiesDisplay" style="white-space: pre-line;"></p>
                <hr />
                <p><h5 style="color: #004973">Requirement:</h5></p>
                <p id="requirementDisplay" style="white-space: pre-line;"></p>
                <hr />
                <p><h5 style="color: #004973">Application Information:</h5></p>
                <p id="applicationInformationDisplay" style="white-space: pre-line;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
