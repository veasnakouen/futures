@model MtpApp.ViewModels.JobsViewModel

<div class="row g-3">
    
        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-header bg-dark text-white"><i class="fa fa-filter me-2"></i>Salary Range</div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small">From</label>
                            <input id="start" name="start" type="number" value="150" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">To</label>
                            <input id="end" name="end" type="number" value="300" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <button type="button" id="btnFilterSalary" class="btn btn-primary btn-sm w-100" onclick="FilterBySalary();">
                        <i class="fa fa-search me-1"></i> Search
                    </button>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-dark text-white"><i class="fa fa-tags me-2"></i>By Category</div>
                <div class="card-body p-2">
                    @foreach (var job in Model.JobsByCategory)
                    {
                        <a href="#" class="d-flex justify-content-between align-items-center text-decoration-none text-dark py-1 px-2 rounded hover-bg" onclick='FilterByCategory("@job.Name");'>
                            <span><i class="fa fa-briefcase me-2 text-muted"></i>@job.Name</span>
                            <span class="badge bg-primary rounded-pill">@job.Total</span>
                        </a>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-dark text-white"><i class="fa fa-building me-2"></i>By Employer</div>
                <div class="card-body p-2">
                    @foreach (var job in Model.JobsByEmployer)
                    {
                        <a href="#" class="d-flex justify-content-between align-items-center text-decoration-none text-dark py-1 px-2 rounded hover-bg" onclick='FilterByEmployer("@job.EmployerName");'>
                            <span><i class="fa fa-briefcase me-2 text-muted"></i>@job.EmployerName</span>
                            <span class="badge bg-success rounded-pill">@job.Total</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="fa fa-clipboard-list me-2"></i>
                    <span>Job List <span id="jobCategoryTitle" class="ms-1 badge bg-secondary"></span></span>
                    <button type="button" id="btnJobList" class="btn btn-success btn-sm ms-auto" onclick="ShowAllJobs();">
                        <i class="fa fa-rotate me-1"></i> Show All Available Jobs
                    </button>
                </div>
                <div class="card-body p-0">
                    <div style="overflow-x: auto;">
                        <table id="jobList" class="table table-hover table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 35px">V.ID</th>
                                    <th>Job Position</th>
                                    <th style="width: 75px">Posted</th>
                                    <th style="width: 75px">Closing Date</th>
                                    <th style="width: 80px">Availability</th>
                                    <th style="width: 85px">Contract Type</th>
                                    <th style="width: 50px">Salary</th>
                                    <th style="width: 40px">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

@Html.Partial("_JobDetailModal")

@section scripts
{
    <script src="~/Scripts/Functions/futuresdashboard.js"></script>
}

