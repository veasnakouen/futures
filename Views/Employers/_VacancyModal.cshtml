<form id="formEmployer" method="post">
    <div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="vacancyModal" tabindex="-1" role="dialog" aria-labelledby="vacancyModal" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-clipboard-list me-2"></i>Vacancy Information</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input id="id" name="id" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="sector">Sector</label>
                                <select class="form-control form-control-sm" id="sector">
                                    <option>Bar Tender</option>
                                    <option>Art</option>
                                    <option>Beauty</option>
                                    <option>Business</option>
                                    <option>Construction</option>
                                    <option>Education</option>
                                    <option>Hospitality</option>
                                    <option>Repairs</option>
                                    <option>Manufacturing</option>
                                    <option>Transport</option>
                                    <option>Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Company Name</label>
                                <input id="name" name="name" placeholder="Enter company name" type="text" value="" class="form-control form-control-sm" style="min-width: 100%" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" id="btnUpdate" class="btn btn-primary btn-sm js-update" onclick="Update();">Update</button>
                    <button type="button" id="btnSave" class="btn btn-success btn-sm" onclick="Save();">Save</button>
                </div>
            </div>
        </div>
    </div>
</form>
