@model MtpApp.ViewModels.EmployerViewModel

<div class="card">
    <div class="card-header bg-dark text-white d-flex align-items-center flex-wrap gap-2">
        <i class="fa fa-building me-1"></i>
        <span class="fw-semibold">Manage Employers</span>
        <div class="ms-auto d-flex flex-wrap gap-1">
            @Html.ActionLink("Manage Vacancy", "Index", "Vacancies", null, new { @class = "btn btn-outline-secondary btn-sm" })
            <button data-bs-toggle="modal" data-bs-target="#jobPositionModal" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-plus me-1"></i> Job Position
            </button>
            <button data-bs-toggle="modal" data-bs-target="#jobCategoryModal" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-plus me-1"></i> Job Category
            </button>
            <button onclick="clearForm();" data-bs-toggle="modal" data-bs-target="#employerModal" class="btn btn-primary btn-sm">
                <i class="fa fa-briefcase me-1"></i> Add Employer
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <label for="displayStatus" class="mb-0 text-nowrap">Status:</label>
                <select class="form-select form-select-sm" id="displayStatus" style="width:auto;">
                    <option>Active</option>
                    <option>Inactive</option>
                </select>
            </div>
            <button data-bs-toggle="modal" data-bs-target="#newPartnerFilter" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-search me-1"></i> Filter New Partner
            </button>
            <button onclick="resetFilter();" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-rotate me-1"></i> Reset Filter
            </button>
        </div>
        <div style="overflow-x: auto;">
            <table id="employers" class="table table-hover table-bordered">
                <thead>
                    <tr>
                        <th style="width: 35px">E.ID</th>
                        <th style="width: 95px">Corporate Date</th>
                        <th style="width: 60px">Duration</th>
                        <th>Employer Name</th>
                        <th>Sector</th>
                        <th>Contact Person</th>
                        <th>Contact Phone</th>
                        <th>Email</th>
                        <th style="width: 90px;">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

@Html.Partial("_EmployerModal")

@Html.Partial("_JobCategoryModal")

@Html.Partial("_JobPositionModal")

@Html.Partial("_NewPartnerFilter")

@section scripts
{
    <script src="~/Scripts/Functions/jobposition.js"></script>
    <script src="~/Scripts/Functions/jobcategory.js"></script>
    <script src="~/Scripts/Functions/employer.js"></script>
}

