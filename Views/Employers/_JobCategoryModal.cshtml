<div class="modal fade" id="jobCategoryModal" role="dialog">
    <div class="modal-dialog">
        <div class="modal-body">
            <div class="panel panel-primary">
                <div class="panel-heading clearfix">
                    <button type="button" class="btn btn-danger btn-xs pull-right" data-dismiss="modal">&times;</button>
                    <h5 class="modal-title">Manage Job Categories</h5>
                </div>
                <div class="panel-body">
                    <div class="input-group">
                        <input id="id" name="id" type="text" style="display: none;" disabled="disabled" value="" class="form-control" />
                        <input id="jobCategoryName" name="name" placeholder="Enter job category name" type="text" value="" class="form-control input-sm" disabled />
                        <span class="input-group-btn">
                            <button type="button" id="btnjobCategoryAction" class="btn btn-primary btn-sm" onclick="JobCategoryAction();">Add New</button>
                           
                        </span>
                        <div id="divLoadingModal"></div>
                    </div>
                    <hr />
                    <table id="jobCategoryTable" class="table table-hover table-bordered table-responsive" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Job Category</th>
                                <th>Action</th> 
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
